  <data name="Settings_Ai_OpenAI_Endpoint_Header.Header" xml:space="preserve">
    <value>OpenAI-compatible endpoint (base URL)</value>
  </data>
  <data name="Settings_Ai_OpenAI_Endpoint_Help.Text" xml:space="preserve">
    <value>Point this at any server that speaks the OpenAI chat-completions API. Examples: https://api.openai.com/v1 (OpenAI), http://localhost:11434/v1 (Ollama), http://localhost:1234/v1 (LM Studio), http://localhost:8000/v1 (vLLM / llama.cpp). Include the version segment your server uses; /chat/completions is appended automatically.</value>
  </data>
  <data name="Settings_Ai_OpenAI_Model_Header.Header" xml:space="preserve">
    <value>OpenAI-compatible model</value>
  </data>
